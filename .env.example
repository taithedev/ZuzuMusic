# ZuzuMusic Neon database was provisioned under Neon project young-truth-44623930
# (currently named Zuzify App Data), database: zuzumusic, branch: main.
# Copy this project's DATABASE_URL from the Neon Console into the server-only
# Vercel environment variable or local .env.local. Never commit real credentials.
# Copy to .env.local; never commit secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zuzumusic-audio
# Your account UUID after signup, NOT username
ADMIN_USER_IDS=
