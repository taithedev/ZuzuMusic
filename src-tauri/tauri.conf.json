{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZuzuMusic",
  "version": "0.1.0",
  "identifier": "lol.zuzify.zuzumusic",
  "build": {
    "frontendDist": "../dist-native",
    "beforeBuildCommand": "npm run build:native"
  },
  "app": {
    "windows": [
      {
        "title": "ZuzuMusic",
        "width": 1360,
        "height": 850,
        "minWidth": 760,
        "minHeight": 560,
        "backgroundColor": "#0c0d14"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
